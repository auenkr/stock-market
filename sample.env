# API (Rust server)
# dev also lists internal endpoints on the homepage and in swagger.json
ENVIRONMENT=dev
PORT=3000
VALKEY_URL=redis://localhost:6379
VALKEY_CACHE_PREFIX=stock-market:dev
SOURCE_BASE_URL=https://www.screener.in
SOURCE_COOKIE=
SOURCE_PACING_MS=1200

# MCP (Node adapter and Cloudflare Worker)
STOCK_MARKET_API_URL=https://stock-market-api.auenkr.com
MCP_HOST=127.0.0.1
MCP_PORT=8788
# Optional: required only for the OpenAI Apps challenge endpoint.
OPENAI_APPS_CHALLENGE=

# CLI
# No environment variables are required. Optional API URL override:
# LEGERLINE_API_URL=https://stock-market-api.auenkr.com
