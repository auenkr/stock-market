{
  "name": "@auenkr/legerline-mcp",
  "version": "1.0.0",
  "description": "Stateless HTTP MCP server for the Ledgerline Stock Market API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auenkr/stock-market.git",
    "directory": "apps/mcp"
  },
  "bin": {
    "legerline-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=es2022 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "build:worker": "esbuild src/worker.ts --bundle --format=esm --platform=browser --target=es2022 --conditions=workerd --external:node:* --external:cloudflare:* --outfile=dist/worker.js",
    "prepublishOnly": "pnpm build",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.20.6",
    "wrangler": "^4.141.0"
  }
}
