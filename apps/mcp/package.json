{
  "name": "@stock-market/mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=es2022 --outfile=../../dist/apps/mcp/index.js",
    "build:worker": "esbuild src/worker.ts --bundle --format=esm --platform=browser --target=es2022 --conditions=workerd --external:node:* --external:cloudflare:* --outfile=../../dist/apps/mcp/worker.js",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.20.6",
    "wrangler": "^4.141.0"
  }
}
