{
  "name": "@stock-market/cli",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=es2022 --outfile=../../dist/apps/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scrape": "tsx src/index.ts",
    "metrics": "tsx ../../packages/scraper/src/metrics/index.ts"
  },
  "dependencies": {
    "@stock-market/common": "workspace:*",
    "@stock-market/scraper": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
