{
  "name": "stock-market-api",
  "main": "../../dist/apps/api/server.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "pnpm --filter @stock-market/api build",
    "watch_dir": [
      "src",
      "../../packages/common/src",
      "../../packages/scraper/src"
    ]
  },
  "vars": {
    "BASE_URL": "https://www.screener.in",
    "PUBLIC_URL": "https://stock-market-api.auenkr.com",
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "stock-market-api.auenkr.com",
      "custom_domain": true
    }
  ]
}
