{
  "name": "stock-market-api",
  "main": "../../dist/apps/api/server.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "pnpm --filter @stock-market/api build",
    "watch_dir": [
      "src",
      "../../packages/common/src",
      "../../packages/scraper/src"
    ]
  },
  "keep_vars": true,
  // Query caching is disabled on this configuration to keep authorization fresh.
  "hyperdrive": [
    { "binding": "ACCOUNT_HYPERDRIVE", "id": "609da84cf3e042dd8a011224d00d9eb2" }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BASE_URL": "https://www.screener.in",
    "CACHE_ENABLED": "true",
    "EDGE_CACHE_ENABLED": "true",
    "VALKEY_CACHE_PREFIX": "stock-market:production",
    "PUBLIC_URL": "https://stock-market-api.auenkr.com",
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "stock-market-api.auenkr.com",
      "custom_domain": true
    }
  ]
}
