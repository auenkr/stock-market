{
  "name": "@stock-market/api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node ../../scripts/dev-app.mjs api",
    "deploy:api": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "test:integration": "node tests/run.mjs integration",
    "test:performance": "node tests/run.mjs performance"
  },
  "dependencies": {
    "@stock-market/common": "workspace:*",
    "@stock-market/scraper": "workspace:*",
    "axios": "^1.13.1",
    "hono": "^4.13.7",
    "postgres": "^3.4.9",
    "@stock-market/agent-tools": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "esbuild": "^0.28.1",
    "wrangler": "^4.141.0",
    "@stock-market/db": "workspace:*"
  }
}
