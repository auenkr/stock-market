{
  "name": "stock-market",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "sync:clients": "tsx scripts/sync-clients.ts",
    "sync:clients:check": "tsx scripts/sync-clients.ts --check",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "dev": "node scripts/dev.mjs",
    "test:api": "cargo test --manifest-path apps/api-rs/Cargo.toml",
    "test:mcp": "pnpm --filter @auenkr/legerline-mcp test",
    "test:cli": "pnpm --filter @stock-market/agent-tools build && pnpm --filter @auenkr/legerline-cli test",
    "test:ci": "pnpm typecheck && pnpm test:api && pnpm test:mcp && pnpm test:cli && pnpm build && pnpm --filter @auenkr/legerline-mcp build:worker"
  },
  "devDependencies": {
    "@nx/js": "^21.5.2",
    "@types/node": "^24.5.2",
    "nx": "^21.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
