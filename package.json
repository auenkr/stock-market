{
  "name": "stock-market",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "plugin:package": "node scripts/package-chatgpt-plugin.mjs",
    "docs:generate": "tsx apps/api/scripts/generate-swagger.ts",
    "docs:check": "tsx apps/api/scripts/generate-swagger.ts --check",
    "test:api": "pnpm --filter @stock-market/db build && pnpm --filter @stock-market/agent-tools build && pnpm --filter @stock-market/common build && pnpm --filter @stock-market/scraper build && pnpm --filter @stock-market/api test",
    "test:mcp": "pnpm --filter @auenkr/legerline-mcp test",
    "test:cli": "pnpm --filter @stock-market/db build && pnpm --filter @stock-market/agent-tools build && pnpm --filter @stock-market/common build && pnpm --filter @auenkr/legerline-cli test:screen",
    "test:auth": "pnpm --filter @stock-market/db build && tsx --test packages/db/src/id.test.ts packages/auth/src/config.test.ts packages/auth/src/billing.test.ts apps/web/src/lib/profile.test.ts",
    "build": "nx run-many -t build",
    "dev": "node scripts/dev.mjs",
    "typecheck": "nx run-many -t typecheck",
    "dev:api": "nx dev @stock-market/api",
    "dev:web": "nx dev @stock-market/web",
    "dev:orchestrator": "nx dev @stock-market/orchestrator",
    "dev:worker": "nx dev @stock-market/worker",
    "scrape": "nx scrape @stock-market/cli",
    "metrics": "nx metrics @stock-market/cli",
    "deploy:api": "nx deploy:api @stock-market/api",
    "db:push": "pnpm --filter @stock-market/web db:push",
    "test:keys": "tsx --test apps/web/src/lib/key-expiration.test.ts apps/web/src/lib/code-snippets.test.ts",
    "db:seed:dev": "pnpm --filter @stock-market/db build && pnpm --filter @stock-market/auth seed:dev",
    "test:integration": "pnpm --filter @stock-market/api test:integration",
    "test:contract:rust": "node apps/api-rs/tests/contract.mjs",
    "test:e2e": "node apps/api/tests/run.mjs e2e",
    "test:payments:live": "node --env-file=.env apps/web/node_modules/@playwright/test/cli.js test --config apps/web/playwright.payments.config.ts",
    "test:performance": "pnpm --filter @stock-market/api test:performance",
    "test:web": "pnpm --filter @stock-market/db build && pnpm --filter @stock-market/web test",
    "test:ci": "node scripts/test-ci.mjs",
    "db:migrate": "pnpm --filter @stock-market/web exec drizzle-kit push && node --env-file=.env packages/db/scripts/migrate-all.mjs",
    "db:create:password-account": "pnpm --filter @stock-market/db build && pnpm --filter @stock-market/auth create:password-account"
  },
  "devDependencies": {
    "@nx/js": "^21.5.2",
    "@types/node": "^24.5.2",
    "nx": "^21.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
