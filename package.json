{
  "name": "stock-market",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "db:migrate:billing": "node --env-file=.env packages/db/scripts/migrate-billing.mjs",
    "docs:generate": "tsx apps/api/scripts/generate-swagger.ts",
    "docs:check": "tsx apps/api/scripts/generate-swagger.ts --check",
    "source:taxonomy": "pnpm --filter @stock-market/scraper build && node --env-file=.env --import tsx apps/api/scripts/refresh-taxonomy.ts",
    "test:api": "pnpm --filter @stock-market/common build && pnpm --filter @stock-market/scraper build && pnpm --filter @stock-market/api test",
    "test:auth": "pnpm --filter @stock-market/db build && tsx --test packages/db/src/id.test.ts packages/auth/src/config.test.ts apps/web/src/lib/profile.test.ts",
    "build": "nx run-many -t build",
    "dev": "node scripts/dev.mjs",
    "typecheck": "nx run-many -t typecheck",
    "dev:api": "nx dev @stock-market/api",
    "dev:web": "nx dev @stock-market/web",
    "dev:orchestrator": "nx dev @stock-market/orchestrator",
    "dev:worker": "nx dev @stock-market/worker",
    "scrape": "nx scrape @stock-market/cli",
    "metrics": "nx metrics @stock-market/cli",
    "deploy:api": "nx deploy:api @stock-market/api",
    "db:push": "pnpm --filter @stock-market/web db:push",
    "db:migrate:api-keys": "node --env-file=.env packages/db/scripts/migrate-api-key-encryption.mjs",
    "db:migrate:onboarding": "node --env-file=.env packages/db/scripts/migrate-onboarding.mjs",
    "db:migrate:usage-policy": "node --env-file=.env packages/db/scripts/migrate-usage-policy.mjs",
    "db:migrate:simplify-api-keys": "node --env-file=.env packages/db/scripts/migrate-simplify-api-keys.mjs",
    "db:migrate:timestamps": "node --env-file=.env packages/db/scripts/migrate-application-timestamps.mjs",
    "db:migrate:key-expiration": "node --env-file=.env packages/db/scripts/migrate-api-key-expiration.mjs",
    "db:migrate:request-limit": "node --env-file=.env packages/db/scripts/migrate-default-request-limit.mjs",
    "db:migrate:api-plans": "node --env-file=.env packages/db/scripts/migrate-api-plans.mjs",
    "db:migrate:account-usage": "node --env-file=.env packages/db/scripts/migrate-account-usage.mjs",
    "test:keys": "tsx --test apps/web/src/lib/key-expiration.test.ts",
    "db:seed:dev": "pnpm --filter @stock-market/db build && pnpm --filter @stock-market/auth seed:dev",
    "test:integration": "pnpm --filter @stock-market/api test:integration",
    "test:e2e": "node apps/api/tests/run.mjs e2e",
    "test:payments:live": "node --env-file=.env apps/web/node_modules/@playwright/test/cli.js test --config apps/web/playwright.payments.config.ts",
    "test:integration:finedge": "node --env-file=.env --import tsx --test apps/api/tests/live/finedge.test.ts",
    "test:performance": "pnpm --filter @stock-market/api test:performance",
    "test:web": "pnpm --filter @stock-market/db build && pnpm --filter @stock-market/web test",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:pre-push": "node scripts/pre-push.mjs"
  },
  "devDependencies": {
    "@nx/js": "^21.5.2",
    "@types/node": "^24.5.2",
    "nx": "^21.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
