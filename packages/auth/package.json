{
  "name": "@stock-market/auth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/consent.ts src/api-key-crypto.ts --bundle --format=esm --platform=node --target=es2022 --packages=external --outdir=dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:dev": "node --env-file-if-exists=../../.env scripts/seed-dev-account.mjs",
    "create:password-account": "node --env-file-if-exists=../../.env scripts/create-password-account.mjs"
  },
  "exports": {
    "./consent": {
      "types": "./src/consent.ts",
      "import": "./dist/consent.js"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./api-key-crypto": {
      "types": "./src/api-key-crypto.ts",
      "import": "./dist/api-key-crypto.js"
    }
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@polar-sh/better-auth": "^2.0.0",
    "@polar-sh/sdk": "^1.0.2",
    "@stock-market/db": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2"
  }
}
