  "dependencies": {
    "@stock-market/db": "workspace:*",
    "better-auth": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2"
  }
}
