{
  "name": "@stock-market/common",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/config.ts src/env.ts src/logger.ts src/api-reference.ts --format=esm --platform=node --target=es2022 --outdir=dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "source": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
