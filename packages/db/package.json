{
  "name": "@stock-market/db",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/schema.ts src/id.ts src/account-access.ts --format=esm --platform=node --target=es2022 --packages=external --outbase=src --outdir=dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./dist/schema.js"
    },
    "./id": {
      "types": "./src/id.ts",
      "import": "./dist/id.js"
    },
    "./account-access": {
      "types": "./src/account-access.ts",
      "import": "./dist/account-access.js"
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2"
  }
}
